# 复制本文件为 gradle.properties 后再构建（该文件被 .gitignore 忽略，不会提交）
#
# 可选数据源 API key —— 不填也能用 Open-Meteo / Met Norway 等免费源
GEO_NAMES_USERNAME=your_geonames_username_here
MF_KEY=your_mf_key_here
ACCU_KEY=your_accu_key_here
WEATHERAPI_KEY=your_weatherapi_key_here

# Gradle / Kotlin
org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
kotlin.code.style=official

# Windows 下项目路径包含中文时，取消下面这行的注释（AGP 默认会拒绝非 ASCII 路径）
# android.overridePathCheck=true